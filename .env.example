# Copy to .env for LOCAL development. Never commit .env.
# In the cloud these values come from your secret manager, not from a file in git.

APP_NAME=campus-app
APP_OWNER=Your Name (student ID)
APP_VERSION=dev

# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-to-at-least-32-random-characters

# PostgreSQL (default compose profile)
DB_PASSWORD=Change-Me-L0cal!
DB_URL=postgresql+psycopg://app_rw:$${DB_PASSWORD}@postgres:5432/campus
# MySQL instead (docker compose --profile mysql up):
# DB_URL=mysql+pymysql://app_rw:$${DB_PASSWORD}@mysql:3306/campus
MYSQL_ROOT_PASSWORD=Change-Me-R00t!

# Optional ClickHouse analytics side-store (docker compose --profile clickhouse up)
CLICKHOUSE_PASSWORD=Change-Me-CH!
# CLICKHOUSE_URL=clickhouse://analytics:Change-Me-CH!@clickhouse:8123/campus

# Object storage: local | s3 | gcs
STORAGE_BACKEND=local
BUCKET=/app/data/uploads

LOG_LEVEL=INFO
LOG_FORMAT=json
PASSWORD_MIN_LENGTH=12

GRAFANA_ADMIN_PASSWORD=Change-Me-Graf4na!
